rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      // A user may read only their own profile; admins may read any profile
      // and list the roster. A blanket `read` would let any signed-in customer
      // query the whole collection and harvest every member's name/email/phone.
      allow get:  if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == userId;
      // Owners may edit their own profile (name/phone/photo) but NOT their
      // points balance, role, or spend totals. Only admins (via the approval
      // transaction) can change points, role, totalSpent, and spendCarry.
      // .get(_, 0) lets legacy docs without the spend fields compare cleanly.
      allow update: if isAdmin() ||
                       (isOwner(userId)
                        && request.resource.data.points == resource.data.points
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.get('totalSpent', 0) == resource.data.get('totalSpent', 0)
                        && request.resource.data.get('spendCarry', 0) == resource.data.get('spendCarry', 0));
      allow delete: if false; // Never allow user deletion
    }
    
    // Bill submissions - PERMANENT STORAGE
    match /billSubmissions/{billId} {
      allow read: if request.auth != null && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      // Customers submit their own bills with a numeric claimed amount, but can
      // never pre-award themselves points — points are set only by admin approval.
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.pointsAwarded == 0 &&
                       request.resource.data.amount is number;
      allow update: if isAdmin(); // Only admins can update (approve/reject)
      allow delete: if false; // NEVER DELETE BILLS - Keep for 2+ months minimum
    }
    
    // Redemptions
    match /redemptions/{redemptionId} {
      allow read: if request.auth != null &&
                     (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null
                       && request.resource.data.userId == request.auth.uid
                       && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if false; // Keep redemption history
    }
    
    // Rewards
    match /rewards/{rewardId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Promos
    match /promos/{promoId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Point transactions
    match /pointTransactions/{transactionId} {
      allow read: if request.auth != null &&
                     (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update, delete: if false; // Transactions are immutable
    }

    // Receipt-image dedup locks: one doc per approved receipt hash, written by the
    // admin approval transaction. Customers never touch this collection.
    match /receiptHashes/{hash} {
      allow read, write: if isAdmin();
    }

    // Receipt-reference dedup locks: one doc per approved receipt ref hash (Ref2 / bill id),
    // written by the admin approval transaction. Customers never touch this collection.
    match /receiptRefs/{refHash} {
      allow read, write: if isAdmin();
    }
  }
}
