rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      // Owners may edit their own profile (name/phone/photo) but NOT their
      // points balance or role. Only admins can change points and role.
      allow update: if isAdmin() ||
                       (isOwner(userId)
                        && request.resource.data.points == resource.data.points
                        && request.resource.data.role == resource.data.role);
      allow delete: if false; // Never allow user deletion
    }
    
    // Bill submissions - PERMANENT STORAGE
    match /billSubmissions/{billId} {
      allow read: if request.auth != null && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && 
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin(); // Only admins can update (approve/reject)
      allow delete: if false; // NEVER DELETE BILLS - Keep for 2+ months minimum
    }
    
    // Redemptions
    match /redemptions/{redemptionId} {
      allow read: if request.auth != null && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && 
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false; // Keep redemption history
    }
    
    // Rewards
    match /rewards/{rewardId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Promos
    match /promos/{promoId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Point transactions
    match /pointTransactions/{transactionId} {
      allow read: if request.auth != null && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update, delete: if false; // Transactions are immutable
    }
  }
}
